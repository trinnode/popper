# ===========================================================================
# POPPER environment template
# ===========================================================================
# Copy this file to .env and fill in values. Everything with a value below is
# PUBLIC and needs no account. Items marked SECRET require action; follow the
# comment for how to obtain each one. NEVER commit .env to git.
#
# cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# NEAR network (public, no account needed)
# ---------------------------------------------------------------------------
# Mainnet RPC. Public endpoint, rate limited. For heavy use create a free
# dedicated key at https://nearops.dev/dashboard/rpc or use a provider such as
# https://docs.near.org/api/rpc/providers and set it here.
NEXT_PUBLIC_NEAR_NETWORK=mainnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.mainnet.near.org
NEAR_RPC_URL=https://rpc.mainnet.near.org
# Fallback RPCs used automatically when the primary fails.
NEAR_RPC_FALLBACK_URLS=https://rpc.fastnear.com,https://free.rpc.fastnear.com

# The account hosting the Popper commitment contract on mainnet.
# Default below is the official deployment target. If you fork this repo,
# deploy your own contract (see scripts/deploy-contract.sh) and change this.
NEXT_PUBLIC_POPPER_CONTRACT_ID=popper.trinnode.near
POPPER_CONTRACT_ID=popper.trinnode.near

# ---------------------------------------------------------------------------
# Public data APIs (all keyless on the free tier as of Nov 2026)
# ---------------------------------------------------------------------------
# DefiLlama: no key, no auth. Endpoints used by the engine are documented in
# packages/engine/src/sources/defillama.ts
DEFILLAMA_TVL_BASE_URL=https://api.llama.fi
DEFILLAMA_OVERVIEW_BASE_URL=https://api.llama.fi/overview
DEFILLAMA_PROTOCOL_SLUG=near-intents

# CoinGecko public API. The free public tier requires no key and allows
# roughly 10 to 30 calls per minute. The engine caches and pins every response
# so a demo run uses well under the limit.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# SECRET (optional): CoinGecko Demo API key for higher limits.
# How to get it: create a free account at https://www.coingecko.com/en/api
# then copy your demo key from the dashboard and set:
# COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxx
COINGECKO_API_KEY=

# ---------------------------------------------------------------------------
# SECRET: NEAR mainnet account for the contract owner (writes commitments and
# attested results on chain).
#
# HOW TO GET IT (choose one, both are free):
#   1. Web wallet: create an account at https://app.mynearwallet.com
#      (for example trinnode.near), fund it with about 3 NEAR, then run:
#        near account import-account using-web-wallet mynearwallet \
#          trinnode.near network-config mainnet
#      This stores a local key file under ~/.near-credentials, NEVER in the repo.
#   2. Ledger hardware wallet: near account import-account using-ledger ...
#
# The deployer key is read from the local keychain at runtime:
#   POPPER_ADMIN_ACCOUNT_ID=trinnode.near
# Key files live at ~/.near-credentials/mainnet/<account>.json and are loaded
# by scripts/deploy-contract.sh through near-cli-rs. Nothing secret is read
# from this .env file itself.
POPPER_ADMIN_ACCOUNT_ID=trinnode.near

# ---------------------------------------------------------------------------
# SECRET (optional): IPFS pinning for a backup copy of claims.json.
# HOW TO GET IT: create a free account at https://pinata.cloud, generate an
# API JWT at https://pinata.cloud/developers/api-keys and set:
#   PINATA_JWT=<your jwt>
# Without this the on-chain commitment and the git history of claims.json are
# still fully sufficient for verification; IPFS is defense in depth.
PINATA_JWT=

# ---------------------------------------------------------------------------
# Frontend build flags
# ---------------------------------------------------------------------------
# Set to 1 only when you have no network access and want the web app to serve
# pinned snapshots only (CI and the local judge flow keep this at 0).
NEXT_PUBLIC_OFFLINE_MODE=0
